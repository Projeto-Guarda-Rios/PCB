		(uuid "151fbccd-93be-4aab-afe2-554d9d3942da")
	)
	(text "IN1 solar, IN2 USB. PR1 and CP2 grounded: highest-voltage selection.\nR74/R75 solar OV: 8.28V nominal. R76/R77 USB OV: 5.75V nominal.\nU11 retains the shared USB current limit. No source is tied to main +5V."
		(exclude_from_sim no)
		(at 15.24 134.62 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2f125cea-eb1a-4ca9-a2dc-3fbf4d555441")
	)
	(text "TH1 is the existing cell-surface probe. Open/short forces both windows OFF.\nC30 stays BEFORE the ADC switch. ADC scale is 1/2 with 200kR NTC loading.\n3.0V reference and monitor remain powered while the main boost is off."
		(exclude_from_sim no)
		(at 20.32 240.03 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "3f67268a-203a-47b5-93ed-565f2a07179e")
	)
	(text "CHG_ALLOW LOW: Q8 off raises CE; Q10 on raises TS.\nBOOST_ALLOW LOW: the battery/solar boost is disabled.\nUSB direct system power remains available for programming.\nU17 grounds the ADC whenever CPU_EN is low."
		(exclude_from_sim no)
		(at 215.9 237.49 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "77e80dee-bbf2-4180-bd56-b6cdc808c701")
	)
	(text "CHARGER INPUT ISOLATION"
		(exclude_from_sim no)
		(at 19.05 20.32 0)
		(effects
			(font
				(size 1.52 1.52)
				(bold yes)
			)
			(justify left)
		)
		(uuid "be27847d-865c-4214-b268-928bf34379dc")
	)
	(text "ALWAYS-ON CELL TEMPERATURE MONITOR"
		(exclude_from_sim no)
		(at 19.05 146.05 0)
		(effects
			(font
				(size 1.52 1.52)
				(bold yes)
			)
			(justify left)
		)
		(uuid "cdb7c17f-4cb0-4145-b020-ab80637c6a2e")
	)
	(text "Development schematic only. Layout has NOT been updated. Validate cell-temperature trips and USB-only startup on hardware.\nWindow estimates include resistor / NTC / comparator tolerances; probe mounting and lag require physical testing."
		(exclude_from_sim no)
		(at 15.24 280.67 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "db0ff752-cc26-4afa-8ddb-f385b7f9ca9a")
	)
