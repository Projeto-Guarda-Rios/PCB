    {
      "id": "F01",
      "priority": "high",
      "status": "confirmed",
      "refs": [
        "L1",
        "U3",
        "C14"
      ],
      "finding": "L1 has no inductance or exact part/rating. Boost capacitor sizing cannot be closed. C14 is nominal 10uF; TPS61200 guidance is about 11uF for 2.2uH, before DC-bias and tolerance allowance."
    },
    {
      "id": "F02",
      "priority": "high",
      "status": "confirmed local circuit; system outcome depends on remote bias or permanently active driver",
      "refs": [
        "R18",
        "R28",
        "R3",
        "U8"
      ],
      "finding": "Local terminated idle bias is about 30mV, or 15mV with two terminators, below the guaranteed +200mV receiver high threshold."
    },
    {
      "id": "F03",
      "priority": "high for programming",
      "status": "confirmed",
      "refs": [
        "Q2",
        "R16",
        "U4",
        "U5"
      ],
      "finding": "Q2 pin2/emitter connects to IO0_BTN; pin3/collector connects to USB_DTR. The normal reference circuit uses emitter on DTR and collector on GPIO0."
    },
    {
      "id": "F04",
      "priority": "high",
      "status": "confirmed voltage loss; external acceptance pending",
      "refs": [
        "D1",
        "D2",
        "R22",
        "R23",
        "J8",
        "J11"
      ],
      "finding": "Boost feedback sets about 5.005V before D1. Both sources pass through Schottky diodes, so the +5V distribution is below its nominal label and is not regulated at the connector."
    },
    {
