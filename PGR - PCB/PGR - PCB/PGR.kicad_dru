(version 1)

(rule "USB full-speed pair geometry"
	# JLC04161H-3313, 1 oz outer copper; 90 ohm non-coplanar differential microstrip over L2 GND. 5.34 mil width / 6 mil gap from JLCPCB calculator 2026-10-27. Skew and uncoupled limits are conservative project targets for 12 Mbit/s USB.
	(condition "A.NetName == 'D+' || A.NetName == 'D-'")
	(constraint track_width (min 0.127mm) (opt 0.135636mm) (max 0.145mm))
	(constraint diff_pair_gap (min 0.14mm) (opt 0.1524mm) (max 0.17mm))
	(constraint skew (opt 0mm) (max 1mm) (within_diff_pairs))
	(constraint diff_pair_uncoupled (max 5mm))
	(severity error)
)
